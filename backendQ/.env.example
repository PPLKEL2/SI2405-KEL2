PORT=4000
CLIENT_ORIGIN=http://localhost:3000
SESSION_SECRET=ganti_dengan_kunci_acak_lokal_minimal_32_karakter
SESSION_TTL_SECONDS=86400
# Pada localhost HTTP development, biarkan COOKIE_SECURE=false agar browser mengirim cookie HttpOnly melalui HTTP lokal.
# Pada lingkungan HTTPS / produksi, atur COOKIE_SECURE=true (atau aktif otomatis saat request HTTPS / NODE_ENV=production).
COOKIE_SECURE=false
