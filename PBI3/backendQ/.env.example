# Port server backend API (default: 4000)
PORT=4000

# URL origin frontend yang diizinkan (CORS)
# Catatan: Alamat localhost, 127.0.0.1, dan IP lokal (192.168.x.x) diizinkan secara aman.
CLIENT_ORIGIN=http://localhost:3000

# (Opsional) Lokasi file penyimpanan katalog kendaraan.
# Default: backendQ/data/vehicles.json (dibuat otomatis, jangan di-commit)
# VEHICLES_DATA_FILE=./data/vehicles.json
