# Konfigurasi Lingkungan MobilitiQ (Sprint 1 Local)
# Salin berkas ini menjadi .env pada backendQ/ atau frontendQ/ bila ingin menyesuaikan port

# Port server REST API Express (backendQ)
PORT=4000

# URL asal aplikasi frontend untuk CORS
CLIENT_ORIGIN=http://localhost:3000

# Kunci penandatanganan sesi cookie HTTP-only (ganti untuk penggunaan lokal)
SESSION_SECRET=ganti_dengan_kunci_acak_lokal_minimal_32_karakter

# Masa berlaku sesi dalam detik (default: 86400 detik = 24 jam)
SESSION_TTL_SECONDS=86400

# Pengaturan atribut cookie Secure:
# - false: untuk development lokal di http://localhost agar cookie HttpOnly tetap dikirim browser melalui HTTP
# - true: wajib diaktifkan saat berjalan di atas HTTPS (juga aktif otomatis jika request HTTPS atau NODE_ENV=production)
COOKIE_SECURE=false

# URL dasar API untuk Next.js (frontendQ)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
